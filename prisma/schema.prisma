generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PostStatus {
  PENDING
  PUBLISHED
  FAILED
}

model Post {
  id                 String     @id @default(uuid()) @db.Uuid
  caption            String     @db.Text
  mediaUrl           String     @db.Text
  cloudinaryPublicId String     @db.Text
  platforms          Json       @default("[]")
  status             PostStatus @default(PENDING)
  createdAt          DateTime   @default(now())
}

model Settings {
  id                 String   @id @default("store")
  storeName          String   @default("بيت ورد") @db.Text
  defaultHashtags    String   @default("#بيت_ورد #تنسيق_زهور") @db.Text
  facebookPageId     String   @default("") @db.Text
  instagramAccountId String   @default("") @db.Text
  tiktokAccountId    String   @default("") @db.Text
  updatedAt          DateTime @updatedAt
}
